# REVIVE Environment Configuration Example
# Copy to .env and adjust as necessary

# Environment & Server
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Database (PostgreSQL default, falls back to SQLite if unreachable or sqlite://)
DATABASE_URL=postgresql://revive_user:revive_password@localhost:5432/revive_db
# SQLite fallback: sqlite:///./revive.db

# Redis (for caching, locks, and task coordination)
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Test Mode or Mock Mode)
RAZORPAY_KEY_ID=rzp_test_REVIVE123456
RAZORPAY_KEY_SECRET=REVIVE_TEST_SECRET_KEY_987654
RAZORPAY_WEBHOOK_SECRET=REVIVE_WEBHOOK_SECRET_456789
RAZORPAY_MOCK_MODE=true

# AI / LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
ENABLE_LLM_REASONING=true
LLM_TIMEOUT_SECONDS=3.0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
