# ==============================================================================
# REVIVE — Enterprise Environment Configuration Template
# ==============================================================================
# WARNING: NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and configure strong, unique secrets for each environment.

# ------------------------------------------------------------------------------
# 1. Environment & Operational Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=production                # production | staging | development
PORT=8000
DEBUG=false                           # Always false in production

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Session Secrets (REQUIRED)
# ------------------------------------------------------------------------------
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_MIN_48_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
APPROVAL_SECRET_KEY=REPLACE_WITH_MIN_48_CHAR_AGENT_APPROVAL_TOKEN_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=30        # Access token expiration window
REFRESH_TOKEN_EXPIRE_DAYS=7           # Refresh token session window

# ------------------------------------------------------------------------------
# 3. Database Isolation (PostgreSQL)
# ------------------------------------------------------------------------------
# Production connection string with credentials (TLS enabled where supported)
DATABASE_URL=postgresql://revive_user:REPLACE_WITH_SECURE_DB_PASSWORD@localhost:5432/revive_db
# Local SQLite fallback: sqlite:///./revive.db

POSTGRES_USER=revive_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD
POSTGRES_DB=revive_db

# ------------------------------------------------------------------------------
# 4. Redis Rate Limiting & Sliding Windows
# ------------------------------------------------------------------------------
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@localhost:6379/0
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 5. Razorpay FinTech Webhook & Payment Credentials
# ------------------------------------------------------------------------------
# Separate Test Mode and Live Mode credentials
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_MERCHANT_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_MERCHANT_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_HMAC_SHA256_WEBHOOK_SECRET
RAZORPAY_MOCK_MODE=false              # Set true only for offline/local simulation

# ------------------------------------------------------------------------------
# 6. Local AI / Ollama Inference Guardrails
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
ENABLE_LLM_REASONING=true
LLM_TIMEOUT_SECONDS=3.0               # Strict inference timeout

# ------------------------------------------------------------------------------
# 7. Frontend & Network Security
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000     # Strict CORS allowlist
